<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>fingerprint_helper</AssemblyName>
    <RootNamespace>FuelPoint.FingerprintHelper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <DpSdkLib Condition="'$(DpSdkLib)' == ''">C:\Program Files\DigitalPersona\U.are.U SDK\Windows\Lib</DpSdkLib>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DPUruNet">
      <HintPath>$(DpSdkLib)\.NET\DPUruNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(DpSdkLib)\x64\dpfpdd.dll" Condition="Exists('$(DpSdkLib)\x64\dpfpdd.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>dpfpdd.dll</Link>
    </None>
    <None Include="$(DpSdkLib)\x64\dpfj.dll" Condition="Exists('$(DpSdkLib)\x64\dpfj.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>dpfj.dll</Link>
    </None>
  </ItemGroup>
</Project>
